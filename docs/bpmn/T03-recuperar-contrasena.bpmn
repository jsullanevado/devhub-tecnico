    <bpmn:sequenceFlow id="T03_f7" sourceRef="validar" targetRef="gEnlace" />
    <bpmn:sequenceFlow id="T03_f8" sourceRef="gEnlace" targetRef="caducado" name="No" />
    <bpmn:sequenceFlow id="T03_f9" sourceRef="caducado" targetRef="finSin" />
