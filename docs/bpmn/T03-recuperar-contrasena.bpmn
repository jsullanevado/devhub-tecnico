          <bpmn:flowNodeRef>enviar</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>validar</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>gEnlace</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>update</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="T03_carril_bd" name="BD">
          <bpmn:flowNodeRef>guardar</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="inicio" name="Pulsa «¿Olvidaste tu contraseña?»">
      <bpmn:outgoing>T03_f1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="correo" name="Ingresar el correo">
      <bpmn:incoming>T03_f1</bpmn:incoming>
      <bpmn:outgoing>T03_f2</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="reset" name="Auth: resetPasswordForEmail (vuelve a /auth/reset-password)">
      <bpmn:incoming>T03_f2</bpmn:incoming>
      <bpmn:outgoing>T03_f3</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="enviar" name="Enviar correo con enlace de un solo uso">
      <bpmn:incoming>T03_f3</bpmn:incoming>
      <bpmn:outgoing>T03_f4</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:task id="confirmar" name="Mostrar confirmación del envío">
      <bpmn:incoming>T03_f4</bpmn:incoming>
      <bpmn:outgoing>T03_f5</bpmn:outgoing>
    </bpmn:task>
    <bpmn:intermediateCatchEvent id="abre" name="Abre el enlace del correo">
      <bpmn:incoming>T03_f5</bpmn:incoming>
      <bpmn:outgoing>T03_f6</bpmn:outgoing>
      <bpmn:messageEventDefinition id="abre_def" />
    </bpmn:intermediateCatchEvent>
    <bpmn:serviceTask id="validar" name="Validar el enlace (evento PASSWORD_RECOVERY)">
      <bpmn:incoming>T03_f6</bpmn:incoming>
      <bpmn:outgoing>T03_f7</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="gEnlace" name="¿Enlace válido?">
      <bpmn:incoming>T03_f7</bpmn:incoming>
      <bpmn:outgoing>T03_f8</bpmn:outgoing>
      <bpmn:outgoing>T03_f10</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="caducado" name="Mostrar «enlace caducado» y ofrecer pedir otro">
      <bpmn:incoming>T03_f8</bpmn:incoming>
      <bpmn:outgoing>T03_f9</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="finSin" name="Sin cambios">
      <bpmn:incoming>T03_f9</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:userTask id="nueva" name="Ingresar la nueva contraseña (mín. 8)">
      <bpmn:incoming>T03_f10</bpmn:incoming>
      <bpmn:outgoing>T03_f11</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="update" name="Auth: updateUser (contraseña)">
      <bpmn:incoming>T03_f11</bpmn:incoming>
      <bpmn:outgoing>T03_f12</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:scriptTask id="guardar" name="Actualizar la credencial en auth.users">
      <bpmn:incoming>T03_f12</bpmn:incoming>
      <bpmn:outgoing>T03_f13</bpmn:outgoing>
    </bpmn:scriptTask>
    <bpmn:task id="entrar" name="Confirmar y entrar a la app">
      <bpmn:incoming>T03_f13</bpmn:incoming>
      <bpmn:outgoing>T03_f14</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="fin" name="Contraseña cambiada">
      <bpmn:incoming>T03_f14</bpmn:incoming>
    </bpmn:endEvent>
