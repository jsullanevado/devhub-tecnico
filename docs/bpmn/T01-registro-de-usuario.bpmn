  <bpmn:collaboration id="T01_colaboracion">
    <bpmn:participant id="T01_pool" name="T01 · Registro de usuario" processRef="T01_proceso" />
  </bpmn:collaboration>
  <bpmn:process id="T01_proceso" name="T01 · Registro de usuario" isExecutable="false">
    <bpmn:documentation>Alta de una cuenta nueva con correo y contraseña. La cuenta queda pendiente hasta confirmar el correo.</bpmn:documentation>
    <bpmn:laneSet id="T01_carriles">
      <bpmn:lane id="T01_carril_front" name="Front">
          <bpmn:flowNodeRef>inicio</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>completar</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>validar</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>gValido</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>marcar</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>mostrarError</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>finError</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>avisar</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>fin</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="T01_carril_servicio" name="Servicio">
          <bpmn:flowNodeRef>signUp</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>gAceptado</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>correo</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="T01_carril_bd" name="BD">
          <bpmn:flowNodeRef>insertarUsuario</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>perfil</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="inicio" name="Abre «Regístrate»">
      <bpmn:outgoing>T01_f1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="completar" name="Completar usuario, nombre, correo y contraseña">
      <bpmn:incoming>T01_f1</bpmn:incoming>
      <bpmn:incoming>T01_f5</bpmn:incoming>
      <bpmn:outgoing>T01_f2</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:task id="validar" name="Validar formulario (formato y confirmación)">
      <bpmn:incoming>T01_f2</bpmn:incoming>
      <bpmn:outgoing>T01_f3</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="gValido" name="¿Datos válidos?">
      <bpmn:incoming>T01_f3</bpmn:incoming>
      <bpmn:outgoing>T01_f4</bpmn:outgoing>
      <bpmn:outgoing>T01_f6</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="marcar" name="Marcar errores en los campos">
      <bpmn:incoming>T01_f4</bpmn:incoming>
      <bpmn:outgoing>T01_f5</bpmn:outgoing>
    </bpmn:task>
    <bpmn:serviceTask id="signUp" name="Auth: signUp (correo, contraseña y metadatos)">
      <bpmn:incoming>T01_f6</bpmn:incoming>
      <bpmn:outgoing>T01_f7</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="gAceptado" name="¿Aceptado?">
      <bpmn:incoming>T01_f7</bpmn:incoming>
      <bpmn:outgoing>T01_f8</bpmn:outgoing>
      <bpmn:outgoing>T01_f10</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="mostrarError" name="Mostrar error (p. ej. correo ya registrado)">
      <bpmn:incoming>T01_f8</bpmn:incoming>
      <bpmn:outgoing>T01_f9</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="finError" name="Registro rechazado">
      <bpmn:incoming>T01_f9</bpmn:incoming>
      <bpmn:errorEventDefinition id="finError_def" />
    </bpmn:endEvent>
    <bpmn:scriptTask id="insertarUsuario" name="Insertar usuario en auth.users">
      <bpmn:incoming>T01_f10</bpmn:incoming>
      <bpmn:outgoing>T01_f11</bpmn:outgoing>
    </bpmn:scriptTask>
    <bpmn:subProcess id="perfil" name="SP01 · Crear perfil (trigger)">
      <bpmn:documentation>Detalle en SP01-crear-perfil.bpmn</bpmn:documentation>
      <bpmn:incoming>T01_f11</bpmn:incoming>
      <bpmn:outgoing>T01_f12</bpmn:outgoing>
    </bpmn:subProcess>
    <bpmn:serviceTask id="correo" name="Enviar correo de confirmación">
      <bpmn:incoming>T01_f12</bpmn:incoming>
      <bpmn:outgoing>T01_f13</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:task id="avisar" name="Mostrar «Revisa tu correo»">
      <bpmn:incoming>T01_f13</bpmn:incoming>
      <bpmn:outgoing>T01_f14</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="fin" name="Cuenta pendiente de confirmar">
      <bpmn:incoming>T01_f14</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="T01_f1" sourceRef="inicio" targetRef="completar" />
    <bpmn:sequenceFlow id="T01_f2" sourceRef="completar" targetRef="validar" />
    <bpmn:sequenceFlow id="T01_f3" sourceRef="validar" targetRef="gValido" />
    <bpmn:sequenceFlow id="T01_f4" sourceRef="gValido" targetRef="marcar" name="No" />
    <bpmn:sequenceFlow id="T01_f5" sourceRef="marcar" targetRef="completar" />
    <bpmn:sequenceFlow id="T01_f6" sourceRef="gValido" targetRef="signUp" name="Sí" />
    <bpmn:sequenceFlow id="T01_f7" sourceRef="signUp" targetRef="gAceptado" />
    <bpmn:sequenceFlow id="T01_f8" sourceRef="gAceptado" targetRef="mostrarError" name="Error" />
    <bpmn:sequenceFlow id="T01_f9" sourceRef="mostrarError" targetRef="finError" />
    <bpmn:sequenceFlow id="T01_f10" sourceRef="gAceptado" targetRef="insertarUsuario" name="OK" />
    <bpmn:sequenceFlow id="T01_f11" sourceRef="insertarUsuario" targetRef="perfil" />
    <bpmn:sequenceFlow id="T01_f12" sourceRef="perfil" targetRef="correo" />
    <bpmn:sequenceFlow id="T01_f13" sourceRef="correo" targetRef="avisar" />
    <bpmn:sequenceFlow id="T01_f14" sourceRef="avisar" targetRef="fin" />
    <bpmn:textAnnotation id="nota1">
      <bpmn:text>El rol nunca se toma de los datos del cliente: toda cuenta nueva es «user».</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="nota1_asoc" sourceRef="nota1" targetRef="perfil" />
  </bpmn:process>
